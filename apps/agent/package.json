{
  "name": "@oracle-duval/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./mcp": "./src/mcp.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
