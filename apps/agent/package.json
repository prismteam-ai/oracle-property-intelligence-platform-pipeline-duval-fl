    "@opensearch-project/opensearch": "^2.13.0",
    "@oracle-duval/shared": "workspace:*",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0"
