# =============================================================================
# Oracle Pipeline — Duval County, FL
# Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.

# --- Filebase (S3-compatible IPFS pinning) ---
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET_OPEN_DATA=elephant-oracle-open-data-duval
FILEBASE_BUCKET_QUERY_TABLE=elephant-oracle-query-table-duval

# --- Webhook Configuration ---
# Comma-separated list of webhook URLs to notify after publish
WEBHOOK_URLS=
# HMAC-SHA256 secret for webhook signature verification
WEBHOOK_SECRET=

# --- Database ---
# Postgres connection string (Docker Compose default shown)
DATABASE_URL=postgresql://oracle:oracle_dev_password@localhost:5432/oracle_pipeline
POSTGRES_PASSWORD=oracle_dev_password

# --- Restate ---
RESTATE_RUNTIME_ENDPOINT=http://localhost:8080
RESTATE_ADMIN_ENDPOINT=http://localhost:9070

# --- AWS Credentials (for CDK deployment) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-2

# --- IPNS Pointers (set after first publish) ---
ORACLE_OPEN_DATA_IPNS_DUVAL=
ORACLE_QUERY_TABLE_IPNS_DUVAL=

# --- Agent / LLM ---
# Vercel AI SDK provider key (Claude or OpenAI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- MCP ---
ORACLE_OPEN_DATA_IPNS_MAP={"duval":""}
ORACLE_QUERY_TABLE_IPNS_MAP={"duval":""}

# --- Node Environment ---
NODE_ENV=development
